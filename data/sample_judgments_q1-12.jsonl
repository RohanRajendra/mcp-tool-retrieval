ge", "source": "bm25 #2", "reason": "Opens the page; reading it is a second step"}, {"server_id": "io.github.microsoft/playwright-mcp", "server": "Playwright (Microsoft)", "tool_name": "browser_navigate", "grade": 2, "group": "open-page", "source": "added by hand", "reason": "Opens the page; reading it is a second step"}, {"server_id": "io.github.microsoft/playwright-mcp", "server": "Playwright (Microsoft)", "tool_name": "browser_snapshot", "grade": 2, "group": "page-snapshot", "source": "added by hand", "reason": "Reads the open page's text"}, {"server_id": "io.github.ChromeDevTools/chrome-devtools-mcp", "server": "Chrome DevTools (Google)", "tool_name": "take_snapshot", "grade": 2, "group": "page-snapshot", "source": "added by hand", "reason": "Reads the open page's text"}, {"server_id": "io.github.YawLabs/fetch-mcp", "server": "Fetch (YawLabs)", "tool_name": "fetch_meta", "grade": 1, "group": null, "source": "bm25 #9", "reason": "Gets the title and description, not prices"}, {"server_id": "io.github.YawLabs/fetch-mcp", "server": "Fetch (YawLabs)", "tool_name": "fetch_robots", "grade": 0, "group": null, "source": "bm25 #5", "reason": "Reads robots.txt"}, {"server_id": "io.github.YawLabs/fetch-mcp", "server": "Fetch (YawLabs)", "tool_name": "fetch_sitemap", "grade": 0, "group": null, "source": "bm25 #7", "reason": "Reads a sitemap"}, {"server_id": "modelcontextprotocol/servers/git", "server": "Git (reference)", "tool_name": "git_remote", "grade": 0, "group": null, "source": "bm25 #4", "reason": "Git remote URLs"}, {"server_id": "io.github.YawLabs/postgres-mcp", "server": "Postgres (YawLabs)", "tool_name": "pg_table_privileges", "grade": 0, "group": null, "source": "bm25 #8", "reason": "Database permissions"}]}
