{"query_id": "q01", "query": "List all tables in my local Postgres database", "category": "postgres", "steps": 1, "narrative": "The user is connected to a local Postgres database and wants the names of its tables, to get oriented before writing queries. A relevant tool returns the table names. A general SQL tool also works, but the agent must write a catalog query first. Tools that list schemas or roles, or show performance stats, do not answer the question.", "judgments": [{"server_id": "io.github.antonorlov/mcp-postgres-server", "server": "Postgres (antonorlov)", "tool_name": "list_tables", "grade": 3, "group": "list-tables", "source": "bm25 #2", "reason": "Lists all tables in a schema"}, {"server_id": "io.github.YawLabs/postgres-mcp", "server": "Postgres (YawLabs)", "tool_name": "pg_list_tables", "grade": 3, "group": "list-tables", "source": "bm25 #8", "reason": "Lists tables in a schema"}, {"server_id": "io.github.YawLabs/postgres-mcp", "server": "Postgres (YawLabs)", "tool_name": "pg_query", "grade": 2, "group": "run-sql", "source": "bm25 #3", "reason": "Works, but needs a hand-written catalog query"}, {"server_id": "io.github.YawLabs/postgres-mcp", "server": "Postgres (YawLabs)", "tool_name": "pg_readonly", "grade": 2, "group": "run-sql", "source": "bm25 #4", "reason": "Same as pg_query, read-only"}, {"server_id": "io.github.antonorlov/mcp-postgres-server", "server": "Postgres (antonorlov)", "tool_name": "query", "grade": 2, "group": "run-sql", "source": "added by hand", "reason": "Works, but needs a hand-written catalog query"}, {"server_id": "io.github.antonorlov/mcp-postgres-server", "server": "Postgres (antonorlov)", "tool_name": "list_schemas", "grade": 1, "group": null, "source": "bm25 #1", "reason": "Lists schemas, not tables"}, {"server_id": "io.github.YawLabs/postgres-mcp", "server": "Postgres (YawLabs)", "tool_name": "pg_list_schemas", "grade": 1, "group": null, "source": "added by hand", "reason": "Lists schemas, not tables"}, {"server_id": "io.github.YawLabs/postgres-mcp", "server": "Postgres (YawLabs)", "tool_name": "pg_list_roles", "grade": 0, "group": null, "source": "bm25 #7", "reason": "Lists users and roles"}, {"server_id": "io.github.YawLabs/postgres-mcp", "server": "Postgres (YawLabs)", "tool_name": "pg_top_queries", "grade": 0, "group": null, "source": "bm25 #6", "reason": "Query performance stats"}, {"server_id": "io.github.YawLabs/postgres-mcp", "server": "Postgres (YawLabs)", "tool_name": "pg_advisor", "grade": 0, "group": null, "source": "bm25 #9", "reason": "Database health checks"}, {"server_id": "io.github.YawLabs/postgres-mcp", "server": "Postgres (YawLabs)", "tool_name": "pg_inspect_locks", "grade": 0, "group": null, "source": "bm25 #10", "reason": "Shows lock contention"}, {"server_id": "io.github.YawLabs/postgres-mcp", "server": "Postgres (YawLabs)", "tool_name": "pg_kill", "grade": 0, "group": null, "source": "bm25 #5", "reason": "Cancels running queries"}]}
{"query_id": "q02", "query": "Show me the commits made on this repo yesterday", "category": "git, github", "steps": 1, "narrative": "The user wants the list of commits made yesterday in the repository they are working on (a local clone that is also on GitHub). Relevant tools list commit history and can filter by date. Tools that change history (rebase, cherry-pick, push) or show one commit or a diff are not what they asked for.", "judgments": [{"server_id": "modelcontextprotocol/servers/git", "server": "Git (reference)", "tool_name": "git_log", "grade": 3, "group": "commit-history", "source": "added by hand", "reason": "Commit log with start and end time filters"}, {"server_id": "io.github.cyanheads/git-mcp-server", "server": "Git (cyanheads)", "tool_name": "git_log", "grade": 3, "group": "commit-history", "source": "added by hand", "reason": "Commit history with since/until filters"}, {"server_id": "io.github.github/github-mcp-server", "server": "GitHub (official)", "tool_name": "list_commits", "grade": 3, "group": "commit-history", "source": "bm25 #5", "reason": "Lists commits on GitHub with since/until"}, {"server_id": "io.github.github/github-mcp-server", "server": "GitHub (official)", "tool_name": "search_commits", "grade": 2, "group": "commit-history", "source": "bm25 #6", "reason": "Date search works, but default branch only"}, {"server_id": "io.github.cyanheads/git-mcp-server", "server": "Git (cyanheads)", "tool_name": "git_show", "grade": 1, "group": null, "source": "bm25 #7", "reason": "Shows one commit; needs its ID first"}, {"server_id": "modelcontextprotocol/servers/git", "server": "Git (reference)", "tool_name": "git_diff", "grade": 1, "group": null, "source": "bm25 #9", "reason": "Shows changes, not the list of commits"}, {"server_id": "io.github.cyanheads/git-mcp-server", "server": "Git (cyanheads)", "tool_name": "git_diff", "grade": 1, "group": null, "source": "bm25 #10", "reason": "Shows changes, not the list of commits"}, {"server_id": "io.github.cyanheads/git-mcp-server", "server": "Git (cyanheads)", "tool_name": "git_rebase", "grade": 0, "group": null, "source": "bm25 #3", "reason": "Rewrites history"}, {"server_id": "io.github.cyanheads/git-mcp-server", "server": "Git (cyanheads)", "tool_name": "git_cherry_pick", "grade": 0, "group": null, "source": "bm25 #4", "reason": "Copies commits between branches"}, {"server_id": "io.github.cyanheads/git-mcp-server", "server": "Git (cyanheads)", "tool_name": "git_push", "grade": 0, "group": null, "source": "bm25 #8", "reason": "Uploads commits"}, {"server_id": "io.github.L337-org/docker-mcp-server", "server": "Docker (L337-org)", "tool_name": "container_diff", "grade": 0, "group": null, "source": "bm25 #1", "reason": "Docker container file changes"}, {"server_id": "io.github.L337-org/docker-mcp-server", "server": "Docker (L337-org)", "tool_name": "image_list", "grade": 0, "group": null, "source": "bm25 #2", "reason": "Lists Docker images"}]}
{"query_id": "q03", "query": "Scan this repo’s history for leaked API keys or passwords", "category": "git", "steps": 1, "narrative": "The user wants to check every past commit in their repository for secrets committed by mistake, such as API keys or passwords, even ones deleted later. No tool in this starter collection scans for secrets directly. (GitHub's server has secret-scanning tools, but they are off by default, so they were not collected.) The closest tools show the content of past commits, so the agent must search that output for key-like patterns itself. Searching only the current files misses secrets that were removed in later commits.", "judgments": [{"server_id": "io.github.cyanheads/git-mcp-server", "server": "Git (cyanheads)", "tool_name": "git_log", "grade": 2, "group": "commit-contents", "source": "added by hand", "reason": "Can show every commit's changes; agent must spot the keys"}, {"server_id": "io.github.cyanheads/git-mcp-server", "server": "Git (cyanheads)", "tool_name": "git_show", "grade": 2, "group": "commit-contents", "source": "added by hand", "reason": "Shows one commit's changes; must repeat for each commit"}, {"server_id": "modelcontextprotocol/servers/git", "server": "Git (reference)", "tool_name": "git_show", "grade": 2, "group": "commit-contents", "source": "added by hand", "reason": "Shows one commit's changes; must repeat for each commit"}, {"server_id": "io.github.cyanheads/git-mcp-server", "server": "Git (cyanheads)", "tool_name": "git_diff", "grade": 2, "group": "commit-contents", "source": "added by hand", "reason": "Diffs one commit range at a time; agent must spot the keys"}, {"server_id": "modelcontextprotocol/servers/git", "server": "Git (reference)", "tool_name": "git_diff", "grade": 2, "group": "commit-contents", "source": "added by hand", "reason": "Diffs one commit range at a time; agent must spot the keys"}, {"server_id": "modelcontextprotocol/servers/git", "server": "Git (reference)", "tool_name": "git_log", "grade": 1, "group": null, "source": "added by hand", "reason": "Lists commits without their content"}, {"server_id": "io.github.github/github-mcp-server", "server": "GitHub (official)", "tool_name": "search_code", "grade": 1, "group": null, "source": "added by hand", "reason": "Searches current code, not history"}, {"server_id": "io.github.j0hanz/filesystem-mcp", "server": "Filesystem (j0hanz)", "tool_name": "search_text", "grade": 1, "group": null, "source": "added by hand", "reason": "Searches current files, not history"}, {"server_id": "io.github.L337-org/docker-mcp-server", "server": "Docker (L337-org)", "tool_name": "image_inspect", "grade": 0, "group": null, "source": "bm25 #1", "reason": "Docker image details"}, {"server_id": "io.github.L337-org/docker-mcp-server", "server": "Docker (L337-org)", "tool_name": "buildx_history_list", "grade": 0, "group": null, "source": "bm25 #2", "reason": "Docker build history"}, {"server_id": "io.github.YawLabs/postgres-mcp", "server": "Postgres (YawLabs)", "tool_name": "pg_seq_scan_tables", "grade": 0, "group": null, "source": "bm25 #3", "reason": "Database scan stats"}, {"server_id": "io.github.YawLabs/fetch-mcp", "server": "Fetch (YawLabs)", "tool_name": "http_options", "grade": 0, "group": null, "source": "bm25 #4", "reason": "HTTP request"}, {"server_id": "io.github.L337-org/docker-mcp-server", "server": "Docker (L337-org)", "tool_name": "image_history", "grade": 0, "group": null, "source": "bm25 #5", "reason": "Docker image layers"}, {"server_id": "io.github.microsoft/playwright-mcp", "server": "Playwright (Microsoft)", "tool_name": "browser_navigate_back", "grade": 0, "group": null, "source": "bm25 #6", "reason": "Browser back button"}, {"server_id": "io.github.L337-org/docker-mcp-server", "server": "Docker (L337-org)", "tool_name": "registry_image_config", "grade": 0, "group": null, "source": "bm25 #7", "reason": "Docker image settings"}, {"server_id": "io.github.L337-org/docker-mcp-server", "server": "Docker (L337-org)", "t