ched run"}, {"server_id": "io.github.L337-org/docker-mcp-server", "server": "Docker (L337-org)", "tool_name": "compose_logs", "grade": 2, "group": "container-output", "source": "bm25 #9", "reason": "Shows output of a Compose run"}, {"server_id": "io.github.L337-org/docker-mcp-server", "server": "Docker (L337-org)", "tool_name": "container_start", "grade": 1, "group": null, "source": "bm25 #10", "reason": "Starts an existing container; cannot create one"}, {"server_id": "io.github.L337-org/docker-mcp-server", "server": "Docker (L337-org)", "tool_name": "container_list", "grade": 0, "group": null, "source": "bm25 #1", "reason": "Lists containers"}, {"server_id": "io.github.L337-org/docker-mcp-server", "server": "Docker (L337-org)", "tool_name": "container_diff", "grade": 0, "group": null, "source": "bm25 #3", "reason": "Container file changes"}, {"server_id": "io.github.L337-org/docker-mcp-server", "server": "Docker (L337-org)", "tool_name": "plugin_install", "grade": 0, "group": null, "source": "bm25 #2", "reason": "Installs a Docker plugin"}, {"server_id": "io.github.j0hanz/filesystem-mcp", "server": "Filesystem (j0hanz)", "tool_name": "replace_text", "grade": 0, "group": null, "source": "bm25 #6", "reason": "Edits files"}, {"server_id": "io.github.antonorlov/mcp-postgres-server", "server": "Postgres (antonorlov)", "tool_name": "query", "grade": 0, "group": null, "source": "bm25 #5", "reason": "Runs SQL"}]}
